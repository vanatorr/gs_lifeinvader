# Copy to .env.local and fill in. NEVER commit .env.local.

DATABASE_URL=mysql://lifeinvader:password@127.0.0.1:3306/lifeinvader_dev
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_DISCORD_ID=your_discord_app_client_id
AUTH_DISCORD_SECRET=your_discord_app_client_secret

# Comma-separated Discord user IDs that can open /business/reseau in local dev
DEV_NETWORK_ADMIN_DISCORD_IDS=

BUSINESS_HOST=localhost
